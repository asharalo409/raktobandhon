document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeModal();
  }
  if (e.ctrlKey || e.metaKey) {
    switch(e.key) {
      case '1': e.preventDefault(); switchPage('dashboard'); break;
      case '2': e.preventDefault(); switchPage('proxies'); break;
      case '3': e.preventDefault(); switchPage('connections'); break;
      case '4': e.preventDefault(); switchPage('rules'); break;
      case '5': e.preventDefault(); switchPage('logs'); break;
    }
  }
});

