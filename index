  initSpeedData();
  renderSpeedChart();
  renderProxies();
  renderConnections();
  renderRules();
  renderLogs();
  
  // Auto-open first proxy group
  toggleProxyGroup(0);
  
  // Start live updates
  setInterval(simulateLiveUpdates, 2000);
  
  // Add new log entries periodically
  setInterval(() => {
    const now = new Date();
    const timeStr = now.toTimeString().slice(0, 8);
    const messages = [
      '[TCP] example.com:443 match Domain-Suffix using Global',
      '[DNS] cache hit for cdn.example.com -> 93.184.216.34',
      '[Proxy] SG-Node-1 latency test: 78ms',
      '[TUN] connection closed from 192.168.1.105:48321',
      '[Rule] no match found, using Final rule',
      '[UDP] dns.cloudflare.com:53 match Direct',
    ];
    const levels = ['info', 'info', 'info', 'debug', 'warn', 'info'];
    const idx = Math.floor(Math.random() * messages.length);
    logsData.push({ time: timeStr, level: levels[idx], msg: messages[idx] });
    if (logsData.length > 100) logsData.shift();
    if (logFilter === 'all' || logFilter === levels[idx]) {
      renderLogs(logFilter);
    }
  }, 3000);
}

