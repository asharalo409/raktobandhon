let proxyFilter = 'all';

function renderProxies(filter) {
  proxyFilter = filter || proxyFilter;
  const container = document.getElementById('proxyGroups');
  const filtered = filter === 'all' ? proxyGroupsData : proxyGroupsData.filter(g => g.type.toLowerCase().replace('-','') === filter);
  
  container.innerHTML = filtered.map((group, gi) => `
    <div class="proxy-group" data-type="${group.type.toLowerCase()}">
      <div class="proxy-group-header" onclick="toggleProxyGroup(${gi})">
        <div class="proxy-group-info">
          <span class="proxy-group-name">${group.name}</span>
          <span class="proxy-group-type ${group.typeClass}">${group.type}</span>
          <span class="proxy-group-current">→ ${group.current}</span>
        </div>
        <div class="proxy-group-toggle" id="pg-toggle-${gi}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
      </div>
      <div class="proxy-list" id="pg-list-${gi}">
        ${group.proxies.map((proxy, pi) => `
          <div class="proxy-item ${proxy.name === group.current ? 'active' : ''}" onclick="selectProxy(${gi}, ${pi})">
            <div class="proxy-radio"></div>
            <span class="proxy-name">${proxy.name}</span>
            <span class="proxy-delay ${getDelayClass(proxy.delay)}">${proxy.delay === 0 ? 'Timeout' : proxy.delay + 'ms'}</span>
          </div>
        `).join('')}
      </div>
    </div>
  `).join('');
}

function getDelayClass(delay) {
  if (delay === 0) return 'delay-timeout';
  if (delay < 60) return 'delay-fast';
  if (delay < 150) return 'delay-medium';
  return 'delay-slow';
}

function toggleProxyGroup(idx) {
  const list = document.getElementById('pg-list-' + idx);
  const toggle = document.getElementById('pg-toggle-' + idx);
  list.classList.toggle('open');
  toggle.classList.toggle('open');
}

function selectProxy(groupIdx, proxyIdx) {
  const group = proxyGroupsData[groupIdx];
  group.current = group.proxies[proxyIdx].name;
  renderProxies(proxyFilter);
  // Reopen the group
