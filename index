<script>
// Page Management
const pageTitles = {
  dashboard: 'Dashboard',
  proxies: 'Proxies',
  connections: 'Connections',
  rules: 'Rules',
  logs: 'Logs',
  settings: 'Settings'
};

function switchPage(pageId) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('page-' + pageId).classList.add('active');
  document.querySelector(`.nav-item[data-page="${pageId}"]`).classList.add('active');
  document.getElementById('pageTitle').textContent = pageTitles[pageId];
  if (window.innerWidth < 768) toggleSidebar();
}

function toggleSidebar() {
  const sidebar = document.getElementById('sidebar');
  const main = document.getElementById('main');
  const overlay = document.getElementById('overlay');
  if (window.innerWidth < 768) {
    sidebar.classList.toggle('open');
    overlay.classList.toggle('active');
  } else {
    sidebar.classList.toggle('collapsed');
    main.classList.toggle('expanded');
  }
}

// Speed Chart
const speedData = { download: [], upload: [] };
const maxPoints = 30;

function initSpeedData() {
  for (let i = 0; i < maxPoints; i++) {
    speedData.download.push(Math.random() * 5 + 1);
    speedData.upload.push(Math.random() * 2 + 0.5);
  }
}

function updateSpeedData() {
  speedData.download.push(Math.random() * 8 + 2);
  speedData.upload.push(Math.random() * 3 + 0.5);
  if (speedData.download.length > maxPoints) speedData.download.shift();
  if (speedData.upload.length > maxPoints) speedData.upload.shift();
  renderSpeedChart();
}

function renderSpeedChart() {
  const container = document.getElementById('speedChart');
  if (!container) return;
  const width = container.clientWidth || 600;
  const height = 200;
  const padding = 30;
  const chartW = width - padding * 2;
  const chartH = height - padding * 2;
  const maxVal = Math.max(...speedData.download, ...speedData.upload, 10);

  function buildPath(data, color, fillColor) {
    const stepX = chartW / (maxPoints - 1);
    let pathD = '';
    let areaD = '';
    data.forEach((val, idx) => {
      const x = padding + idx * stepX;
      const y = padding + chartH - (val / maxVal) * chartH;
      if (idx === 0) {
        pathD += `M ${x} ${y}`;
        areaD += `M ${x} ${padding + chartH} L ${x} ${y}`;
      } else {
        pathD += ` L ${x} ${y}`;
        areaD += ` L ${x} ${y}`;
      }
      if (idx === data.length - 1) {
        areaD += ` L ${x} ${padding + chartH} Z`;
      }
    });
    return { pathD, areaD, fillColor };
  }

  const dl = buildPath(speedData.download, '#22c55e', 'rgba(34,197,94,0.1)');
  const ul = buildPath(speedData.upload, '#3b82f6', 'rgba(59,130,246,0.1)');

  container.innerHTML = `
    <svg viewBox="0 0 ${width} ${height}" preserveAspectRatio="none">
      <defs>
        <linearGradient id="gradDl" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="rgba(34,197,94,0.3)"/>
          <stop offset="100%" stop-color="rgba(34,197,94,0)"/>
        </linearGradient>
        <linearGradient id="gradUl" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="rgba(59,130,246,0.3)"/>
          <stop offset="100%" stop-color="rgba(59,130,246,0)"/>
        </linearGradient>
      </defs>
      <!-- Grid lines -->
      ${[0, 0.25, 0.5, 0.75, 1].map(pct => {
        const y = padding + chartH * (1 - pct);
        return `<line x1="${padding}" y1="${y}" x2="${width - padding}" y2="${y}" stroke="var(--border)" stroke-width="0.5"/>`;
      }).join('')}
      <!-- Download area -->
      <path d="${dl.areaD}" fill="url(#gradDl)"/>
      <path d="${dl.pathD}" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <!-- Upload area -->
      <path d="${ul.areaD}" fill="url(#gradUl)"/>
      <path d="${ul.pathD}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <!-- Current values -->
      <text x="${padding}" y="${padding - 5}" fill="var(--text-secondary)" font-size="10">${maxVal.toFixed(0)} MB/s</text>
      <text x="${padding}" y="${height - 5}" fill="var(--text-muted)" font-size="9">30s ago</text>
      <text x="${width - padding}" y="${height - 5}" fill="var(--text-muted)" font-size="9" text-anchor="end">Now</text>
    </svg>
  `;
}

// Proxy Data
const proxyGroupsData = [
  {
    name: 'Global',
    type: 'Select',
    typeClass: 'type-select',
    current: 'JP-Node-1',
    proxies: [
      { name: 'JP-Node-1', delay: 45 },
      { name: 'US-Node-1', delay: 120 },
      { name: 'SG-Node-1', delay: 89 },
      { name: 'HK-Node-1', delay: 32 },
      { name: 'KR-Node-1', delay: 67 },
      { name: 'TW-Node-1', delay: 55 },
    ]
  },
  {
    name: 'Auto',
